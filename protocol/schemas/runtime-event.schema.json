{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunaagentos.dev/protocol/schemas/runtime-event.schema.json",
  "title": "LunaAgentOS Runtime Event",
  "type": "object",
  "required": ["type", "timestamp"],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["output", "thought", "response", "tool", "plan", "usage", "state", "error", "log"]
    },
    "timestamp": { "type": "string" },
    "source": { "type": "string" },
    "content": { "type": ["string", "null"] },
    "state": { "type": ["string", "null"] },
    "payload": { "type": "object", "additionalProperties": true },
    "visibility": { "type": "string", "enum": ["primary", "secondary", "diagnostic"] }
  },
  "additionalProperties": true
}
