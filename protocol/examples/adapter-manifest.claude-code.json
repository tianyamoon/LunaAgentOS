{
  "$schema": "../schemas/adapter-manifest.schema.json",
  "schemaVersion": "0.1.0-draft",
  "id": "claude-code",
  "displayName": "Claude Code",
  "kind": "registry",
  "status": "active",
  "entryRole": "runtime",
  "description": "Registry adapter for Claude Code as a high-value coding runtime.",
  "surfaces": [
    {
      "kind": "acp_stdio",
