{
  "id": "claude",
  "name": "Claude Code",
  "extension": "builtin.claude",
  "icon": "assets/icon.svg",
  "brandColor": "#D4A27F",
  "transport": "stdio_json",
  "command": [
    "npx",
    "-y",
    "@agentclientprotocol/claude-agent-acp"
  ],
  "requires_pty": false,
  "modelControl": { "mode": "luna_managed" },
  "capabilities": {
    "slashCommands": [
      { "name": "compact", "descriptionKey": "composer.command.compact" },
      { "name": "clear", "descriptionKey": "composer.command.clear" },
      { "name": "status", "descriptionKey": "composer.command.status" },
      { "name": "model", "descriptionKey": "composer.command.model" },
      { "name": "permissions", "descriptionKey": "composer.command.permissions" },
      { "name": "plan", "descriptionKey": "composer.command.plan" },
      { "name": "init", "descriptionKey": "composer.command.init" },
      { "name": "resume", "descriptionKey": "composer.command.resume" },
      { "name": "review", "descriptionKey": "composer.command.review" },
      { "name": "mcp", "descriptionKey": "composer.command.mcp" }
    ]
  },
  "permissions": {
    "processExec": [
      {
        "command": "npx",
        "args": [
          "-y",
          "@agentclientprotocol/claude-agent-acp"
        ]
      },
      {
        "command": "npx.cmd",
        "args": [
          "-y",
          "@agentclientprotocol/claude-agent-acp"
        ]
      },
      {
        "command": "wsl.exe",
        "args": [
          "--exec",
          "npx",
          "-y",
          "@agentclientprotocol/claude-agent-acp"
        ]
      }
    ]
  }
}
